<Bar Breakpoint="Breakpoint.Desktop"
     Background="Background.Light"
     ThemeContrast="ThemeContrast.Light">
    <BarBrand>
        @Title
    </BarBrand>
    <BarToggler />
    <BarMenu>
        <BarEnd>
            <BarItem>
                <Button Color="Color.Primary" Clicked="@HandleButtonAdd">Add</Button>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public EventCallback OnClickAdd { get; set; }

    private async Task HandleButtonAdd(MouseEventArgs e)
    {
        await OnClickAdd.InvokeAsync(false);
    }
}