
<Table>
    <TableHeader>
        <TableRow>
            <TableHeaderCell>#</TableHeaderCell>
            <TableHeaderCell>Name</TableHeaderCell>
            <TableHeaderCell>Quantity</TableHeaderCell>
            <TableHeaderCell>Price</TableHeaderCell>
            <TableHeaderCell></TableHeaderCell>
        </TableRow>
    </TableHeader>

    <TableBody>
        @if(inventories is not null && inventories.Count > 0)
        {
            @foreach (var inventory in inventories)
            {
                <TableRow>
                    <TableRowHeader>@inventory.InventoryId</TableRowHeader>
                    <TableRowCell>@inventory.InventoryName</TableRowCell>
                    <TableRowCell>@inventory.Quantity</TableRowCell>
                    <TableRowCell>@inventory.Price</TableRowCell>
                    <TableRowCell>
                        <Button Color="Color.Secondary" Clicked="@(e => Edit(inventory))">
                            Edit
                        </Button>
                        <Button Color="Color.Danger" Clicked="@(e => Delete(inventory))">
                            Delete
                        </Button>
                    </TableRowCell>
                </TableRow>
            }
        }
        else
        {
            <TableRow>
                <TableRowCell ColSpan="5">
                    <Spinner />
                </TableRowCell>
            </TableRow>
        }
    </TableBody>
</Table>

@code {
    [Parameter]
    public List<Inventory> inventories { get; set; }

    [Parameter]
    public EventCallback<Inventory> OnEditInventory { get; set;}

    [Parameter]
    public EventCallback<Inventory> OnDeleteInventory { get; set; } 
    
    private async Task Edit(Inventory inventory)
    {
        await OnEditInventory.InvokeAsync(inventory);
    }

    private async Task Delete(Inventory inventory)
    {
        await OnDeleteInventory.InvokeAsync(inventory);
    }
}