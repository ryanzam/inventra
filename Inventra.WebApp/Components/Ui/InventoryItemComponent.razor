
@if(Inventory is not null)
{
    <TableRow>
        <TableRowHeader>@Inventory.InventoryId</TableRowHeader>
        <TableRowCell>@Inventory.InventoryName</TableRowCell>
        <TableRowCell>@Inventory.Quantity</TableRowCell>
        <TableRowCell>@Inventory.Price</TableRowCell>
        <TableRowCell>
            <Button Color="Color.Primary">
                Edit
            </Button>
            <Button Color="Color.Danger">
                Delete
            </Button>
        </TableRowCell>
    </TableRow>
}
else
{
    <p>No inventory data available.</p>
}

@code {
    [Parameter]
    public Inventory? Inventory { get; set; }
}
